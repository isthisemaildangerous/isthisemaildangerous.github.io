    <!-- Stripe Checkout Script -->
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        // Initialize Stripe (replace with your actual publishable key)
        const stripe = Stripe('pk_test_YOUR_PUBLISHABLE_KEY');
        
        // Get user email if available (from URL parameter or localStorage)
        const urlParams = new URLSearchParams(window.location.search);
        const userEmail = urlParams.get('email') || localStorage.getItem('userEmail') || '';
        
        function showLoading() {
            document.getElementById('loading').style.display = 'block';
            window.scrollTo(0, 0);
        }
        
        function selectFree() {
            alert('You are currently on the Free plan. No action needed!');
        }
        
        async function selectMonthly() {
            showLoading();
            
            try {
                // Call your backend to create a Stripe Checkout session
                const response = await fetch('https://api.guardmyemail.com/create-checkout-session', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        priceId: 'price_monthly_YOUR_PRICE_ID', // Replace with actual Stripe price ID
                        customerEmail: userEmail,
                        mode: 'subscription'
                    })
                });
                
                const session = await response.json();
                
                // Redirect to Stripe Checkout
                const result = await stripe.redirectToCheckout({
                    sessionId: session.id
                });
                
                if (result.error) {
                    alert(result.error.message);
                    document.getElementById('loading').style.display = 'none';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Something went wrong. Please try again.');
                document.getElementById('loading').style.display = 'none';
            }
        }
        
        async function selectAnnual() {
            showLoading();
            
            try {
                const response = await fetch('https://api.guardmyemail.com/create-checkout-session', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        priceId: 'price_annual_YOUR_PRICE_ID', // Replace with actual Stripe price ID
                        customerEmail: userEmail,
                        mode: 'subscription'
                    })
                });
                
                const session = await response.json();
                
                const result = await stripe.redirectToCheckout({
                    sessionId: session.id
                });
                
                if (result.error) {
                    alert(result.error.message);
                    document.getElementById('loading').style.display = 'none';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Something went wrong. Please try again.');
                document.getElementById('loading').style.display = 'none';
            }
        }
    </script>
    
</body>
</html>
